# Copy this file to .env.local and fill in your own InfluxDB settings.
# Create the organization and bucket with these names in the setup screen,
# or update the values below to match the names you chose.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=school
INFLUX_BUCKET=school-monitor

# Optional: web app address used by both generators to publish live updates.
CLASSROOM_APP_URL=http://localhost:3000
